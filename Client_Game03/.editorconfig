# .editorconfig для C# 13 с рекомендациями по стилю кода
# Этот файл включает новые возможности C# 13 и обеспечивает единообразие стиля кода.

# Указывает, что это корневой файл конфигурации
root = true

# Применяет настройки ко всем C# файлам
[*.cs]
dotnet_diagnostic.IDE1006.severity = error
csharp_style_namespace_declarations = file_scoped:suggestion
dotnet_diagnostic.CS1591.severity = none

# Проверка, что CancellationToken пробрасывается в вызываемые методы
dotnet_diagnostic.VSTHRD110.severity = error
# Ошибка, если асинхронный метод не принимает CancellationToken
dotnet_diagnostic.VSTHRD111.severity = error
# Проверка наличия параметра CancellationToken в асинхронных методах
dotnet_diagnostic.CA2016.severity = error
# Анализатор CA1068: Параметр CancellationToken должен быть в конце (помогает выявлять отсутствие)
dotnet_diagnostic.CA1068.severity = error



# тело выражения или тело блока для методов
csharp_style_expression_bodied_methods = false:none

# Общие настройки
# Использовать кодировку UTF-8
charset = utf-8
# Использовать символы конца строки CRLF (Windows)
end_of_line = crlf
# Использовать пробелы для отступов
indent_style = space
# Размер отступа — 4 пробела
indent_size = 4
# Добавлять пустую строку в конце файла
insert_final_newline = true
# Удалять пробелы в конце строк
trim_trailing_whitespace = true

# Форматирование
# Открывающая фигурная скобка на новой строке
csharp_new_line_before_open_brace = all
# Пустая строка между членами класса
csharp_new_line_between_members = true
# Отступ содержимого в блоках case
csharp_indent_case_contents = true
# Отступ меток в switch
csharp_indent_switch_labels = true
# Отступ содержимого блоков
csharp_indent_block_contents = true
# Пробел после ключевых слов в управляющих конструкциях
csharp_space_after_keywords_in_control_flow_statements = true
# Без пробела после приведения типа
csharp_space_after_cast = false
# Пробел перед двоеточием в наследовании
csharp_space_before_colon_in_inheritance_clause = true
# Пробелы вокруг бинарных операторов
csharp_space_around_binary_operators = before_and_after

# Именование полей и свойств любой видимости, включая public.
dotnet_naming_rule.fields_and_properties_should_be_camel_case.severity = error
dotnet_naming_rule.fields_and_properties_should_be_camel_case.symbols = all_fields_and_properties
dotnet_naming_rule.fields_and_properties_should_be_camel_case.style = camel_case

dotnet_naming_symbols.all_fields_and_properties.applicable_kinds = field, property
dotnet_naming_symbols.all_fields_and_properties.applicable_accessibilities = *

# Явное правило для констант имеет приоритет над общими правилами полей.
dotnet_naming_rule.constants_should_be_upper_snake_case.severity = error
dotnet_naming_rule.constants_should_be_upper_snake_case.symbols = constants
dotnet_naming_rule.constants_should_be_upper_snake_case.style = upper_snake_case

dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.applicable_accessibilities = *
dotnet_naming_symbols.constants.required_modifiers = const

dotnet_naming_style.upper_snake_case.capitalization = all_upper
dotnet_naming_style.upper_snake_case.word_separator = _
dotnet_naming_style.upper_snake_case.required_prefix =
dotnet_naming_style.upper_snake_case.required_suffix =

dotnet_naming_style.camel_case.capitalization = camel_case
dotnet_naming_style.camel_case.required_prefix =
dotnet_naming_style.camel_case.required_suffix =
dotnet_naming_style.camel_case.word_separator =

# Документация
# Требовать комментарии документации для публичных членов
dotnet_style_require_documentation_comments = public:warning

# Каждый элемент должен иметь XML-комментарий
dotnet_diagnostic.SA1600.severity = warning
# Комментарий должен содержать тег <summary>
dotnet_diagnostic.SA1604.severity = warning
# Требуется <param> для всех параметров
dotnet_diagnostic.SA1611.severity = warning
# Требуется <returns> для методов с возвращаемым значением
dotnet_diagnostic.SA1615.severity = warning
# Текст <summary> должен корректно описывать элемент
dotnet_diagnostic.SA1623.severity = warning
# Заголовок файла обязателен (описание/лицензия)
dotnet_diagnostic.SA1633.severity = warning

# Стиль кода
# Требовать модификаторы доступа для членов, не являющихся интерфейсами
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
# Рекомендуемый порядок модификаторов
csharp_preferred_modifier_order = public, protected, internal, private, static, abstract, virtual, sealed, readonly, override, async:warning

# Асинхронные методы
# Методы асинхронного программирования должны иметь суффикс Async
dotnet_style_async_method_names = true:warning
# Принудительно требовать суффикс Async
dotnet_diagnostic.SA1412.severity = warning

# Использование var
# Разрешить использование var для встроенных типов
csharp_style_var_for_built_in_types = false:suggestion
# Разрешить использование var, если тип очевиден
csharp_style_var_when_type_is_apparent = true:suggestion
# Не использовать var, если тип неочевиден
csharp_style_var_elsewhere = false:suggestion

# Интерполяция строк
# Предпочтение упрощённой интерполяции строк
dotnet_style_prefer_simplified_interpolation = true:suggestion

# Коллекционные выражения
# Предпочтение коллекционным выражениям
dotnet_style_prefer_collection_expression = true:suggestion

# Параметры
# Предпочтение авто-свойствам
dotnet_style_prefer_auto_properties = true:suggestion

# Прочее
# Предпочтение проверке на null через is null
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:suggestion
# Предпочтение проверке на null вместо проверки типа
dotnet_style_prefer_null_check_over_type_check = true:suggestion
# Не навязывать использование тернарного оператора вместо присваивания
dotnet_style_prefer_conditional_expression_over_assignment = false:suggestion
# Предпочтение составным операторам присваивания
dotnet_style_prefer_compound_assignment = true:suggestion
# Предпочтение упрощённой проверки на пустую строку
dotnet_style_prefer_simplified_string_empty_check = true:suggestion
# Предпочтение выводу имён элементов кортежей
dotnet_style_prefer_inferred_tuple_names = true:suggestion
# Предпочтение выводу имён членов анонимных типов
dotnet_style_prefer_inferred_anonymous_type_member_names = true:suggestion
# Предпочтение строковым литералам UTF-8
dotnet_style_prefer_utf8_string_literals = true:suggestion
# Предпочтение выражениям switch
dotnet_style_prefer_switch_expression = true:suggestion
# Предпочтение инициализаторам коллекций
dotnet_style_prefer_collection_initializer = true:suggestion
# Предпочтение упрощённым булевым выражениям
dotnet_style_prefer_simplified_boolean_expressions = true:suggestion
# Предпочтение инициализаторам авто-свойств
dotnet_style_prefer_auto_property_initializer = true:suggestion
# Предпочтение выводу имён членов анонимных типов
dotnet_style_prefer_inferred_anonymous_type_member_names = true:suggestion

# Новые возможности C# 13
# Предпочтение использованию коллекций в параметрах
dotnet_style_prefer_params_collection = true:suggestion
# Предпочтение использованию основных конструкторов
dotnet_style_prefer_primary_constructors = true:suggestion
# Предпочтение неявному доступу к индексатору
dotnet_style_prefer_implicit_indexer_access = true:suggestion
# Предпочтение использованию локальных переменных с ref в итераторах
dotnet_style_prefer_ref_locals_in_iterators = true:suggestion
# Предпочтение использованию структур с ref для реализации интерфейсов
dotnet_style_prefer_ref_struct_implement_interfaces = true:suggestion
# Предпочтение использованию структур с ref в качестве параметров типа
dotnet_style_prefer_ref_struct_as_type_parameters = true:suggestion
# Предпочтение использованию частичных свойств
dotnet_style_prefer_partial_properties = true:suggestion
# Предпочтение использованию частичных индексаторов
dotnet_style_prefer_partial_indexers = true:suggestion
csharp_indent_labels = one_less_than_current
csharp_style_throw_expression = true:suggestion
csharp_style_prefer_null_check_over_type_check = true:suggestion
csharp_prefer_simple_default_expression = true:suggestion
csharp_style_prefer_local_over_anonymous_function = true:suggestion
csharp_style_prefer_index_operator = true:suggestion
csharp_style_prefer_range_operator = true:suggestion
csharp_style_implicit_object_creation_when_type_is_apparent = true:suggestion
csharp_style_prefer_implicitly_typed_lambda_expression = true:suggestion
csharp_style_prefer_tuple_swap = true:suggestion
csharp_style_prefer_unbound_generic_type_in_nameof = true:suggestion
csharp_style_prefer_utf8_string_literals = true:suggestion
csharp_style_inlined_variable_declaration = true:suggestion
csharp_style_deconstructed_variable_declaration = true:suggestion
csharp_style_unused_value_assignment_preference = discard_variable:suggestion
csharp_style_unused_value_expression_statement_preference = discard_variable:silent

[*.{cs,vb}]
dotnet_style_operator_placement_when_wrapping = beginning_of_line
tab_width = 4
indent_size = 4
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:suggestion
dotnet_style_prefer_auto_properties = true:suggestion
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_prefer_simplified_boolean_expressions = true:suggestion
dotnet_style_prefer_conditional_expression_over_assignment = false:suggestion
dotnet_style_prefer_conditional_expression_over_return = true:silent
dotnet_style_explicit_tuple_names = true:suggestion
dotnet_style_prefer_inferred_tuple_names = true:suggestion
dotnet_style_prefer_inferred_anonymous_type_member_names = true:suggestion
dotnet_style_prefer_compound_assignment = true:suggestion
dotnet_style_prefer_simplified_interpolation = true:suggestion
dotnet_style_prefer_collection_expression = when_types_exactly_match:suggestion
dotnet_style_namespace_match_folder = true:suggestion
end_of_line = crlf

# Не применяем правила именования проекта к стороннему коду.
[Assets/{Plugins,Packages,TextMesh Pro}/**/*.cs]
dotnet_diagnostic.IDE1006.severity = none
